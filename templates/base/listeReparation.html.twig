{% extends 'base.html.twig' %}

{% block title %}{{ parent() }}Liste des réparation{% endblock %}

{% block body %}
<style>
    .example-wrapper { margin: 1em auto; max-width: 800px; width: 95%; font: 18px/1.5 sans-serif; }
    .example-wrapper code { background: #F5F5F5; padding: 2px 6px; }
</style>

<div class="example-wrapper">
    <h1> Liste des réparations </h1>
    <table class="table table-hover">
        <thead>
            <tr>
                <th>Types de réparation</th>
                <th>Description</th>
                <th>Date de dépôt</th>
                <th>Statut</th>
            </tr>
        </thead>
        <tbody>
        {%for reparation in reparations | sort((a,b)=>b.dateDepot<=>a.dateDepot) %}
            <tr class="{{cycle(['table-primary', 'table-secondary'], loop.index0)}}">                <td>{{reparation.typeReparation}}</td>
                <td>{{reparation.description}}</td>
                <td>{{ reparation.dateDepot ? reparation.dateDepot|date('d/m/Y') : '' }}</td>
                <td>{{reparation.statut}}</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}
